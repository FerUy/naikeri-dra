<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.naikeri</groupId>
    <artifactId>naikeri-dra</artifactId>
    <packaging>pom</packaging>
    <version>2.2.0</version>

    <name>naikeri-dra :: parent</name>
    <modules>
        <module>naikeri-diameter-routing-agent</module>
        <module>management</module>
    </modules>

    <properties>
        <naikeri.artifactory.url>https://ec2-56-126-119-82.sa-east-1.compute.amazonaws.com/artifactory/libs-release-local</naikeri.artifactory.url>
        <naikeri-signaling-gateway-core.version>2.2.0-113</naikeri-signaling-gateway-core.version>
        <compiler.plugin.version>3.14.1</compiler.plugin.version>
        <jar.plugin.version>3.1.2</jar.plugin.version>
        <compile.source>11</compile.source>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <slf4j.version>2.0.17</slf4j.version>
        <log4j2.version>2.26.0</log4j2.version>
        <picocontainer.version>2.13.5</picocontainer.version>
        <commons-pool.version>1.5.5</commons-pool.version>
        <postgresql.version>42.7.12</postgresql.version>
        <jackson-dataformat-yaml.version>2.22.2</jackson-dataformat-yaml.version>
        <jakarta.xml.bind-api.version>4.0.4</jakarta.xml.bind-api.version>
        <jaxb-runtime.version>4.0.7</jaxb-runtime.version>
    </properties>

    <distributionManagement>
        <repository>
            <id>naikeri</id>
            <name>localhost-releases</name>
            <url>${naikeri.artifactory.url}</url>
        </repository>
        <snapshotRepository>
            <id>naikeri</id>
            <name>localhost-snapshots</name>
            <url>${naikeri.artifactory.url}</url>
        </snapshotRepository>
    </distributionManagement>

    <dependencies>
        <dependency>
            <groupId>commons-cli</groupId>
            <artifactId>commons-cli</artifactId>
            <version>1.4</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>${log4j2.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j2.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <version>${log4j2.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!-- https://mvnrepository.com/artifact/info.picocli/picocli -->
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>4.0.0</version>
        </dependency>

        <!-- Jakarta XML Binding: API plus the Eclipse implementation (jaxb-runtime brings jakarta.activation) -->
        <dependency>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
            <version>${jakarta.xml.bind-api.version}</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jaxb</groupId>
            <artifactId>jaxb-runtime</artifactId>
            <version>${jaxb-runtime.version}</version>
            <scope>runtime</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler.plugin.version}</version>
                <configuration>
                    <source>${compile.source}</source>
                    <target>${compile.source}</target>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>naikeri</id>
            <name>Naikeri Artifactory</name>
            <url>${naikeri.artifactory.url}</url>
            <layout>default</layout>
            <releases>
                <enabled>true</enabled>
                <updatePolicy>never</updatePolicy>
            </releases>
            <snapshots>
                <enabled>true</enabled>
                <updatePolicy>never</updatePolicy>
            </snapshots>
        </repository>
    </repositories>
</project>