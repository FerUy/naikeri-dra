<?xml version="1.0"?>
<project name="naikeri.dra.release" default="release" basedir=".">
    <property environment="sys"/>
    <property name="release.dir" location="${ant.file.naikeri.dra.release}/../target" />
    <property name="base.dir" location="${ant.file.naikeri.dra.release}/.." />
    <property name="bin.dir" location="${release.dir}/bin" />
    <property name="conf.dir" location="${release.dir}/conf" />
    <property name="logs.dir" location="${release.dir}/logs" />
    <property name="checkout.dir" value="${base.dir}/checkout" />
    <property name="naikeri.dra.release.version" value="2.1.0-SNAPSHOT" />
    <property name="checkout.naikeri-dra.dir" value="${base.dir}/.." />


    <!-- NAIKERI_SG_VERSION 2.1.0-1 -->
    <property name="sg.build-number" value="1" />
    <property name="sg.version" value="2.1.0" />
    <property name="naikeri-sgw-version" value="${sg.version}-${sg.build-number}" />

    <!-- NAIKERI_SCTP_VERSION 2.0.2-12 -->
    <property name="sctp.build-number" value="17" />
    <property name="sctp.version" value="2.1.0" />
    <property name="naikeri-sctp-version" value="${sctp.version}-${sctp.build-number}" />

    <!-- NAIKERI_JDIAMETER_VERSION 1.7.4-198 -->
    <property name="jDiameter.build-number" value="241" />
    <property name="jDiameter.version" value="2.0.0" />
    <property name="naikeri-jDiameter-version" value="${jDiameter.version}-${jDiameter.build-number}" />

    <!-- NAIKERI_JSS7_VERSION 8.2.6-243 -->
    <property name="jss7.build-number" value="334" />
    <property name="jss7.version" value="8.5.0" />
    <property name="naikeri-jss7-version" value="${jss7.version}-${jss7.build-number}" />

    <property name="release.build.goals" value="clean install dependency:tree -Dmaven.test.skip=true" />

    <condition property="mvn.executable" value="${sys.M2_HOME}\bin\mvn.bat" else="mvn">
        <os family="windows"/>
    </condition>


    <target name="release" depends="clean,build-dra,copy-dra,make-final-zip" />

    <target name="clean">
        <echo>Delete ${release.dir}</echo>
        <delete dir="${release.dir}"/>
        <delete dir="${release.dir}/bin"/>
        <delete dir="${release.dir}/conf"/>
        <delete dir="${release.dir}/logs"/>
        <delete>
            <fileset dir="${base.dir}">
                <include name="naikeri-dra-*.*" />
            </fileset>
        </delete>
    </target>


    <target name="build-dra">
        <echo>building DRA in ${checkout.naikeri-dra.dir} and ${release.build.goals}</echo>
        <exec failonerror="true" executable="${mvn.executable}" dir="${checkout.naikeri-dra.dir}">
            <arg line="${release.build.goals} -Dnaikeri-signaling-gateway-core.version=${naikeri-sgw-version} -Ddiameter.release.version=${naikeri-jDiameter-version} -Dsctp.version=${naikeri-sctp-version} -Djss7.version=${naikeri-jss7-version} -Dmaven.test.skip=true -Passembly" />
        </exec>

        <copy overwrite="true" todir="${release.dir}/bin/libs">
            <fileset file="${base.dir}/../naikeri-diameter-routing-agent/target/libs/**" />
        </copy>

        <copy overwrite="true" todir="${release.dir}/bin">
            <fileset file="${base.dir}/../naikeri-diameter-routing-agent/target/*.jar" />
            <fileset file="${base.dir}/../management/target/*.jar" />
        </copy>


        <copy failonerror="true" todir="${release.dir}/conf">
            <fileset file="${base.dir}/../naikeri-diameter-routing-agent/src/main/resources/*.xml"/>
        </copy>

        <copy failonerror="true" todir="${release.dir}/conf">
            <fileset file="${base.dir}/../naikeri-diameter-routing-agent/src/main/resources/*.yaml"/>
        </copy>

        <copy failonerror="true" todir="${release.dir}/bin">
            <fileset file="${base.dir}/utils/start/**"/>
            <fileset file="${base.dir}/utils/cli/**"/>
        </copy>
        <replace file="${release.dir}/bin/start.sh" token="VERSION" value="${naikeri.dra.release.version}"/>
    </target>

    <target name="copy-dra">
        <mkdir dir="${release.dir}/bin" />
        <mkdir dir="${release.dir}/bin/libs" />
        <mkdir dir="${release.dir}/conf" />
        <mkdir dir="${release.dir}/logs" />
    </target>


    <target name="make-final-zip" depends="set-time-stamp">
        <zip destfile="${base.dir}/Naikeri-DRA-${naikeri.dra.release.version}.zip" filesonly="false">
            <zipfileset dir="${release.dir}" prefix="Naikeri-DRA-${naikeri.dra.release.version}">
                <include name="**" />
            </zipfileset>
        </zip>
    </target>

    <target name="set-time-stamp" unless="skip.timestamp">
        <tstamp>
            <format property="time.stamp" pattern="yyMMddHHmm" />
        </tstamp>
    </target>

</project>