<?xml version="1.0"?>
<project name="naikeri.dra.release" default="release" basedir=".">
    <property name="release.dir" location="${ant.file.naikeri.dra.release}/../target" />
    <property name="base.dir" location="${ant.file.naikeri.dra.release}/.." />
    <property name="checkout.naikeri-dra.dir" value="${base.dir}/.." />

    <!-- Jenkins passes -Dnaikeri.dra.release.version; for a local build this must match the project version in pom.xml,
         because start.sh gets it substituted into the jar name. -->
    <property name="naikeri.dra.release.version" value="2.2.0" />

    <!-- The Signaling Gateway version, and through it jDiameter, jSS7 and SCTP, is set in the Maven POMs, not here. -->
    <property name="release.build.goals" value="clean install dependency:tree -Dmaven.test.skip=true -Passembly" />

    <target name="release" depends="clean,build-dra,collect-dra,make-final-zip" />

    <target name="clean">
        <echo>Delete ${release.dir}</echo>
        <delete dir="${release.dir}"/>
        <delete>
            <fileset dir="${base.dir}">
                <include name="Naikeri-DRA-*.zip" />
            </fileset>
        </delete>
    </target>

    <!-- Skipped with -Dskip.maven.build=true when the Maven build already ran, as in Jenkins -->
    <target name="build-dra" unless="skip.maven.build">
        <echo>Building DRA in ${checkout.naikeri-dra.dir} with ${release.build.goals}</echo>
        <exec failonerror="true" executable="mvn" dir="${checkout.naikeri-dra.dir}">
            <arg line="${release.build.goals}" />
        </exec>
    </target>

    <target name="collect-dra">
        <copy overwrite="true" todir="${release.dir}/bin/libs">
            <fileset file="${base.dir}/../naikeri-diameter-routing-agent/target/libs/**" />
        </copy>

        <copy overwrite="true" todir="${release.dir}/bin">
            <fileset file="${base.dir}/../naikeri-diameter-routing-agent/target/*.jar" />
            <fileset file="${base.dir}/../management/target/*.jar" />
        </copy>

        <copy failonerror="true" todir="${release.dir}/conf">
            <fileset file="${base.dir}/../naikeri-diameter-routing-agent/src/main/config/*.xml"/>
            <fileset file="${base.dir}/../naikeri-diameter-routing-agent/src/main/config/*.yaml"/>
            <fileset file="${base.dir}/../naikeri-diameter-routing-agent/src/main/config/*.sql"/>
        </copy>

        <!-- dictionary.xml comes from the jDiameter mux jar, unpacked by the Maven build, so the deployed
             file is always the stack's own. It stays editable in conf/ for per-deployment changes. -->
        <copy failonerror="true" todir="${release.dir}/conf">
            <fileset file="${base.dir}/../naikeri-diameter-routing-agent/target/dictionary/dictionary.xml"/>
        </copy>

        <copy failonerror="true" todir="${release.dir}/bin">
            <fileset file="${base.dir}/utils/start/**"/>
            <fileset file="${base.dir}/utils/cli/**"/>
        </copy>
        <replace file="${release.dir}/bin/start.sh" token="VERSION" value="${naikeri.dra.release.version}"/>

        <mkdir dir="${release.dir}/logs" />
    </target>

    <target name="make-final-zip">
        <zip destfile="${base.dir}/Naikeri-DRA-${naikeri.dra.release.version}.zip" filesonly="false">
            <zipfileset dir="${release.dir}" prefix="Naikeri-DRA-${naikeri.dra.release.version}" filemode="644">
                <include name="**" />
                <exclude name="bin/*.sh" />
            </zipfileset>
            <zipfileset dir="${release.dir}" prefix="Naikeri-DRA-${naikeri.dra.release.version}" filemode="755">
                <include name="bin/*.sh" />
            </zipfileset>
        </zip>
    </target>
</project>
